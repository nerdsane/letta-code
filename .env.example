# Deep Sci-Fi Environment Variables
# Copy this file to .env and fill in your values
# Bun automatically loads .env files - no additional setup needed

# =============================================================================
# Letta Configuration (Required for agent functionality)
# =============================================================================

# Letta API Key - Get from https://app.letta.com/
# Required unless using OAuth authentication
# LETTA_API_KEY=letta_...

# Letta Base URL - For self-hosted Letta server
# Default: https://api.letta.com (Letta Cloud)
# LETTA_BASE_URL=http://localhost:8283

# =============================================================================
# Image Generation (Optional - for image_generator tool)
# =============================================================================

# OpenAI API Key - For DALL-E image generation (default provider)
# Get from: https://platform.openai.com/api-keys
# Cost: ~$0.040/image (DALL-E 3 standard), ~$0.080/image (DALL-E 3 HD)
# OPENAI_API_KEY=sk-...

# Google API Key - For Gemini/Imagen image generation (alternative provider)
# Get from: https://aistudio.google.com/apikey
# Free tier available, then pay-per-use
# GOOGLE_API_KEY=AIza...
# Or use:
# GEMINI_API_KEY=AIza...

# =============================================================================
# Notion Integration (Optional - for /publish-notion skill)
# =============================================================================

# Notion Integration Token - For publishing stories to Notion
# See: src/skills/builtin/publish-notion/README.md
# NOTION_TOKEN=secret_...

# Notion Database ID - Target database for story publishing
# NOTION_DATABASE_ID=...

# =============================================================================
# Development & Debug (Optional)
# =============================================================================

# Enable debug logging
# LETTA_DEBUG=1

# Disable telemetry (set to 0 or false)
# LETTA_CODE_TELEM=0

# Disable auto-updates
# DISABLE_AUTOUPDATER=1

# Debug auto-update process
# LETTA_DEBUG_AUTOUPDATE=1

# Debug Kitty protocol detection
# LETTA_DEBUG_KITTY=1
